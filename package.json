{
    "name": "@playcanvas/attribute-parser",
    "version": "1.11.2",
    "description": "The PlayCanvas Attribute Parser",
    "keywords": [
        "playcanvas",
        "attribute",
        "parser"
    ],
    "homepage": "https://github.com/playcanvas/attribute-parser#readme",
    "bugs": {
        "url": "https://github.com/playcanvas/attribute-parser/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/playcanvas/attribute-parser.git"
    },
    "license": "MIT",
    "author": "PlayCanvas <support@playcanvas.com>",
    "type": "module",
    "exports": {
        ".": {
            "types": "./types/index.d.ts",
            "node": "./dist/index.node.mjs",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./libs": "./dist/libs.d.ts"
    },
    "main": "dist/index.js",
    "types": "types/index.d.ts",
    "files": [
        "dist/index.node.mjs",
        "dist/libs.d.ts",
        "types"
    ],
    "scripts": {
        "build": "rollup -c && npm run build:types",
        "build:types": "tsc -p tsconfig.build.json",
        "fmt": "prettier --check .",
        "fmt:fix": "prettier --write .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "publint": "publint",
        "test": "mocha",
        "typecheck": "tsc --noEmit",
        "watch": "rollup -c -w"
    },
    "dependencies": {
        "@playcanvas/eslint-config": "3.0.0-beta.8",
        "@typescript/vfs": "^1.6.0",
        "eslint": "^9.0.0",
        "typescript": "^5.5.3"
    },
    "devDependencies": {
        "@rollup/plugin-commonjs": "28.0.9",
        "@rollup/plugin-node-resolve": "16.0.3",
        "@rollup/plugin-swc": "0.4.1",
        "@swc/core": "1.15.43",
        "@types/node": "26.1.0",
        "chai": "5.3.3",
        "mocha": "11.7.6",
        "playcanvas": "2.23.3",
        "prettier": "3.9.4",
        "publint": "0.3.21",
        "rollup": "4.62.2"
    },
    "engines": {
        "node": ">=22.0.0"
    }
}
