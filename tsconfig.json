{
    "compilerOptions": {
        "allowJs": true,
        "esModuleInterop": true,
        "lib": ["es2019", "dom", "dom.iterable"],
        "moduleResolution": "bundler",
        "noImplicitAny": true,
        "outDir": "dist",
        "skipLibCheck": true,
        "sourceMap": true,
        "target": "es6"
    },
    "include": ["src", "test", "rollup.config.mjs"],
    "exclude": ["node_modules", "test/fixtures"]
}
